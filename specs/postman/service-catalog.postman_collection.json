					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"lista ordenada por día y hora\", () => {",
									"    pm.response.to.have.status(200);",
									"    const order = [\"MONDAY\",\"TUESDAY\",\"WEDNESDAY\",\"THURSDAY\",\"FRIDAY\",\"SATURDAY\",\"SUNDAY\"];",
									"    const list = pm.response.json();",
									"    for (let i = 1; i < list.length; i++) {",
									"        const a = order.indexOf(list[i-1].dayOfWeek), b = order.indexOf(list[i].dayOfWeek);",
									"        pm.expect(a).to.be.at.most(b);",
									"        if (a === b) pm.expect(list[i-1].startTime <= list[i].startTime).to.eql(true);",
